<?xml version="1.0" encoding="utf-8"?>
<!--
  Сервер примерки работает на ноутбуке в домашней сети по обычному HTTP
  (сертификата у него нет), а его адрес заранее неизвестен:
  192.168.x.x, 10.x.x.x и т. д. Android не умеет разрешать HTTP для
  диапазона адресов, поэтому HTTP разрешён в целом.

  Внешние сервисы приложение вызывает только по HTTPS (Gemini).
  В боевой версии сервер примерки должен получить HTTPS-сертификат,
  и эту настройку нужно будет убрать.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true"/>
</network-security-config>
